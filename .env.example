NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/srps_gate_pass?replicaSet=rs0


JWT_ACCESS_SECRET=replace-with-a-unique-access-secret-at-least-32-characters

JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-at-least-32-characters

FRONTEND_URL=http://localhost:5173

OTP_DELIVERY_MODE=sms
APITXT_AUTH_KEY=
APITXT_TEMPLATE_ID=



OTP_EXPIRY_MINUTES=5
SCHOOL_NAME=Shree Ram Public School
SCHOOL_ADDRESS=Kanhra-Badhra Road, Charkhi Dadri, Haryana 127306
SEED_ADMIN_EMAIL=admin@srpskanhra.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=SRPS Administrator
TRUST_PROXY=false


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=srpskanhra@gmail.com
SMTP_PASS=
SMTP_FROM="SHREE RAM PUBLIC SCHOOL <srpskanhra@gmail.com>"




# Birthday WhatsApp via APITxT (independent of OTP provider).
# Uses existing APITXT_AUTH_KEY unless APITXT_WHATSAPP_AUTH_KEY is set.
# Public URL is the HTTPS school app origin, without a path.
BIRTHDAY_WHATSAPP_PROVIDER=apitxt
APITXT_WHATSAPP_PROJECT_REF_ID=
BIRTHDAY_PUBLIC_URL=
